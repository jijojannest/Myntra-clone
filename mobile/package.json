{
  "name": "myntra-clone-mobile",
  "version": "1.0.0",
  "description": "Myntra Clone Mobile App - Hybrid React Native Application",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace MyntraClone.xcworkspace -scheme MyntraClone -configuration Release",
    "clean": "react-native clean",
    "pod-install": "cd ios && pod install",
    "postinstall": "cd ios && pod install && cd ../ && cd android && ./gradlew clean"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.72.6",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/drawer": "^6.6.6",
    "@reduxjs/toolkit": "^1.9.7",
    "react-redux": "^8.1.3",
    "react-native-paper": "^5.11.1",
    "react-native-screens": "^3.27.0",
    "react-native-safe-area-context": "^4.7.4",
    "react-native-gesture-handler": "^2.13.4",
    "react-native-vector-icons": "^10.0.2",
    "react-native-async-storage": "^1.19.5",
    "@react-native-async-storage/async-storage": "^1.19.5",
    "react-native-camera": "^4.2.1",
    "react-native-image-picker": "^5.6.0",
    "react-native-permissions": "^3.10.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "^3.5.4",
    "react-native-svg": "^13.14.0",
    "react-native-fast-image": "^8.6.3",
    "react-native-video": "^5.2.1",
    "react-native-share": "^9.4.1",
    "react-native-device-info": "^10.11.0",
    "react-native-netinfo": "^9.4.1",
    "@react-native-firebase/app": "^18.6.1",
    "@react-native-firebase/messaging": "^18.6.1",
    "@react-native-firebase/analytics": "^18.6.1",
    "axios": "^1.6.0",
    "react-query": "^3.39.3",
    "react-hook-form": "^7.47.0",
    "yup": "^1.3.3",
    "react-hook-form-resolvers": "^3.3.2",
    "lottie-react-native": "^6.1.0",
    "react-native-maps": "^1.8.0",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-keychain": "^8.1.3",
    "react-native-biometrics": "^3.0.1",
    "react-native-localize": "^3.0.2",
    "react-native-splash-screen": "^3.3.0",
    "react-native-bootsplash": "^5.1.3",
    "react-native-modal": "^13.0.1",
    "react-native-actions-sheet": "^0.8.29",
    "react-native-really-awesome-button": "^2.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/metro-config": "^0.72.11",
    "@tsconfig/react-native": "^3.0.0",
    "@types/react": "^18.0.0",
    "@types/react-native": "^0.72.6",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "babel-jest": "^29.2.1",
    "eslint": "^8.53.0",
    "eslint-config-react-native": "^7.0.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "^0.76.8",
    "prettier": "^3.0.3",
    "react-test-renderer": "18.2.0",
    "typescript": "5.2.2"
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"],
    "testMatch": [
      "**/__tests__/**/*.(ts|tsx|js)",
      "**/*.(test|spec).(ts|tsx|js)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/*.stories.{ts,tsx}",
      "!src/**/__tests__/**/*",
      "!src/**/index.{ts,tsx}"
    ],
    "coverageReporters": ["text", "lcov", "html"],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|react-native-vector-icons|@react-native|react-native-reanimated)/)"
    ]
  },
  "eslintConfig": {
    "extends": [
      "@react-native",
      "eslint:recommended",
      "@typescript-eslint/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": ["@typescript-eslint"],
    "rules": {
      "react-native/no-inline-styles": "warn",
      "react-native/no-color-literals": "warn",
      "@typescript-eslint/no-unused-vars": "error",
      "react-hooks/exhaustive-deps": "warn"
    }
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSameLine": true,
    "bracketSpacing": false,
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true,
    "printWidth": 80
  }
}